generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Filial {
  id                   Int     @id @default(autoincrement())
  codigo               String  @unique
  cidade               String?
  uf                   String?
  regional             String?
  onda                 String?
  mediaOperacoes90Dias Int     @default(0)

  status        String    @default("NAO_INICIADO")
  dataPrevista  DateTime?
  dataInicio    DateTime?
  dataConclusao DateTime?
  observacao    String?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  eventos EventoRollout[]

  @@index([status])
  @@index([uf])
  @@index([regional])
  @@index([onda])
}

model EventoRollout {
  id             Int      @id @default(autoincrement())
  filialId       Int
  statusAnterior String?
  statusNovo     String
  observacao     String?
  autor          String?
  registradoEm   DateTime @default(now())

  filial Filial @relation(fields: [filialId], references: [id], onDelete: Cascade)

  @@index([filialId])
  @@index([registradoEm])
}

model MetaRollout {
  id                  Int      @id @default(autoincrement())
  data                DateTime @unique
  quantidadeAcumulada Int
  descricao           String?
}

/// Média diária de operações da rede apurada em uma semana.
model MediaOperacoesSemanal {
  id             Int      @id @default(autoincrement())
  semana         DateTime @unique
  mediaOperacoes Int
  /// Operações da semana que rodaram em cada sistema; nulo enquanto não apuradas.
  operacoesLegado       Int?
  operacoesCentralizado Int?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt
}

/// Latência das requisições apurada em uma semana, em milissegundos.
model LatenciaSemanal {
  id           Int      @id @default(autoincrement())
  semana       DateTime @unique
  p50          Int
  p75          Int
  p95          Int
  p99          Int
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

model Demanda {
  id             Int      @id
  titulo         String
  tipo           String
  estado         String?
  url            String
  ativa          Boolean  @default(true)
  sincronizadaEm DateTime @updatedAt
  criadaEm       DateTime @default(now())

  @@index([ativa])
}

model RespostaPriorizacao {
  id           Int      @id @default(autoincrement())
  demandaId    Int      @unique
  beneficiados Int?
  tipoDeGanho  Int?
  frequencia   Int?
  riscoDeAdiar Int?
  esforco      Int?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
