# Copie para .env na VPS: cp .env.example .env

# Porta publicada do frontend no host
PORTA_WEB=8080

# Domínio usado pelo Caddy (perfil tls). Ex.: rollout.seudominio.com.br
DOMINIO=

# Postgres (serviço `db` do compose). Troque a senha antes de subir.
# Qualquer caractere é aceito: o entrypoint escapa a senha ao montar a URL.
POSTGRES_USER=rollout
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rollout

# Sincronização das demandas com as issues do GitLab (aba Priorização).
# Sem token, o botão "Atualizar do GitLab" responde 503.
GITLAB_URL=http://gitlab.queroquero.com.br
GITLAB_TOKEN=

# Origens liberadas no CORS da API. Com o nginx proxiando /api é mesma origem,
# então * é seguro o suficiente aqui; restrinja se expuser a API direto.
CORS_ORIGIN=*

# Recarrega as 587 lojas do TSV a cada start (upsert: preserva status e datas)
SEED_ON_START=true

TZ=America/Sao_Paulo
