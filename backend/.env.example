# Postgres local: `npm run db:up` sobe o container de desenvolvimento na 5433.
DATABASE_URL="postgresql://rollout:rollout@localhost:5433/rollout?schema=public"
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Sincronização das demandas com as issues do GitLab.
# O token precisa do escopo read_api e é lido só pelo botão "Atualizar do GitLab".
GITLAB_URL="http://gitlab.queroquero.com.br"
GITLAB_TOKEN=""
